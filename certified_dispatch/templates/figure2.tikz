\begin{{tikzpicture}}
\begin{{axis}}[title style={{yshift=-5pt}},xlabel style={{yshift=1.5pt}},paperaxis,at={{(0.6cm,0cm)}},anchor=south west,width=3.2cm,height=1.12cm,xmin=0,xmax=15,ymin=-.5,ymax=1.5,xtick={{0,5,10,15}},ytick=\empty,xlabel={{Minutes/driver}},title={{(a) Assignment loss}},grid=none,xmajorgrids,axis y line=none,clip=false]
