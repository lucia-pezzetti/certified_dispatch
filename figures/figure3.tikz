\addplot[paperline,plotgreen,solid,mark=*,mark size=1.65pt,error bars/.cd,y dir=both,y explicit,error bar style={line width=.7pt},error mark options={rotate=90,mark size=1.7pt,line width=.7pt}] table[x=x,y=y,y error=ci,col sep=comma]{data/fig3a_dual_certified.csv};
\addlegendentry{Adjusted dual}
\addplot[paperline,plotgray,dashed,mark=square*,mark size=1.65pt,error bars/.cd,y dir=both,y explicit,error bar style={line width=.7pt},error mark options={rotate=90,mark size=1.7pt,line width=.7pt}] table[x=x,y=y,y error=ci,col sep=comma]{data/fig3a_dual_base.csv};
\addlegendentry{Unadjusted dual}
\addplot[paperline,plotorange,densely dashed,mark=triangle*,mark size=1.65pt,error bars/.cd,y dir=both,y explicit,error bar style={line width=.7pt},error mark options={rotate=90,mark size=1.7pt,line width=.7pt}] table[x=x,y=y,y error=ci,col sep=comma]{data/fig3a_direct_upper.csv};
\addlegendentry{Direct, $U+\eta$}
\addplot[paperline,plotblue,dashdotted,mark=diamond*,mark size=1.65pt,error bars/.cd,y dir=both,y explicit,error bar style={line width=.7pt},error mark options={rotate=90,mark size=1.7pt,line width=.7pt}] table[x=x,y=y,y error=ci,col sep=comma]{data/fig3a_direct_upper_matched.csv};
\addlegendentry{Direct, shifted}
